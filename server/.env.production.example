# ============== PRODUCTION ENVIRONMENT ==============
# Copy to .env.production and fill with real values before deploying

# ============== MONGODB ==============
# Use MongoDB Atlas (managed service) for production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster-name.mongodb.net/humansafety?retryWrites=true&w=majority

# ============== SERVER ==============
PORT=5000
NODE_ENV=production

# ============== JWT ==============
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_64_CHAR_MIN_STRONG_SECRET_KEY_HERE_GENERATED_WITH_CRYPTO
JWT_EXPIRE=7d
OTP_EXPIRE=5m

# ============== AI ENGINE ==============
# Use internal Docker network or deployed AI service URL
AI_ENGINE_URL=http://ai-engine:8000
AI_TIMEOUT=30000
AI_MAX_RETRIES=3

# ============== SMS CONFIGURATION ==============
# Choose real provider: twilio, msg91, aws-sns
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_production_twilio_account_sid
TWILIO_AUTH_TOKEN=your_production_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# Alternate: MSG91
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_production_key

# ============== FIREBASE (Push Notifications) ==============
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQE...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# ============== CORS ==============
# Restrict to your mobile app domain/frontend URL
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ============== SECURITY ==============
DEFAULT_RADIUS_KM=10
HOSPITAL_REQUEST_TIMEOUT=10000
MAX_HOSPITAL_ATTEMPTS=3
ACCIDENT_CONFIDENCE_THRESHOLD=70

# ============== RATE LIMITING ==============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============== LOGGING ==============
LOG_LEVEL=warn
LOG_DIR=/var/log/humansafety

# ============== REDIS (Optional - for real-time and caching) ==============
REDIS_URL=redis://redis:6379

# ============== EMAIL SERVICE ==============
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com

# ============== GOOGLE MAPS ==============
GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key_with_restrictions
