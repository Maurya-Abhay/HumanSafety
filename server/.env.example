# ============== MONGODB ==============
MONGODB_URI=mongodb://localhost:27017/humansafety
# OR for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/humansafety

# ============== SERVER ==============
PORT=5000
NODE_ENV=development

# ============== JWT ==============
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRY=7d

# ============== AI ENGINE ==============
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT=5000

# ============== SMS SERVICE ==============
SMS_PROVIDER=twilio  # or nexmo, sns
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============== EMAIL SERVICE ==============
EMAIL_SERVICE=gmail  # or sendgrid, ses
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ============== CORS ==============
CORS_ORIGIN=http://localhost:3000,http://localhost:8100

# ============== LOGGING ==============
LOG_LEVEL=info  # debug, info, warn, error

# ============== RATE LIMITING ==============
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============== GOOGLE MAPS ==============
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
