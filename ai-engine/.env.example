# ============== AI ENGINE SETTINGS ==============
PORT=8000
HOST=0.0.0.0
WORKERS=4

# ============== ENVIRONMENT ==============
ENVIRONMENT=development  # production, development, testing

# ============== LOGGING ==============
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ============== PERFORMANCE ==============
BUFFER_SIZE=100
WINDOW_SIZE=500
PROCESSING_TIMEOUT=5000

# ============== SAFETY THRESHOLDS ==============
ACCIDENT_IMPACT_THRESHOLD=20
ACCIDENT_CONFIDENCE_THRESHOLD=0.6
IMPACT_MAGNITUDE_THRESHOLD=15
ROLLOVER_ROTATION_THRESHOLD=4.0
SPEED_DROP_PERCENTAGE_THRESHOLD=50

# ============== FALSE ALARM FILTERING ==============
PHONE_DROP_DETECTION=enabled
VIBRATION_ONLY_FILTER=enabled
POCKET_PLACEMENT_FILTER=enabled
SPEED_VARIATION_FILTER=enabled
CONTEXT_VALIDATION=enabled

# ============== EMERGENCY THRESHOLDS ==============
CRITICAL_RISK_THRESHOLD=80
HIGH_RISK_THRESHOLD=60
MEDIUM_RISK_THRESHOLD=40
LOW_RISK_THRESHOLD=20

# ============== BEHAVIOR LEARNING ==============
ENABLE_BEHAVIOR_LEARNING=true
ENABLE_ADAPTIVE_THRESHOLDS=true
LEARNING_WINDOW_DAYS=30
