APP_NAME=HumanSafety
APP_VERSION=1.0.0

# API Configuration
API_PROTOCOL=https
API_HOST=humansafety.onrender.com
API_PORT=
WS_PROTOCOL=wss
WS_HOST=humansafety.onrender.com
WS_PORT=

# AI Engine
AI_ENGINE_URL=https://humansafety-ai.onrender.com

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_SENSOR_FUSION=true
ENABLE_AUDIO_ANALYSIS=true
ENABLE_BACKGROUND_TRACKING=true

# Environment
ENVIRONMENT=development
# Options: development, staging, production

# Debug Logging
DEBUG_LOGS=true
